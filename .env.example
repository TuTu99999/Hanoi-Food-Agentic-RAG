APP_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hanoi_food
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=hanoi-food-api
JWT_AUDIENCE=hanoi-food-web
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1,host.docker.internal
TRUST_PROXY_HEADERS=false

GEMINI_API_KEY=replace-with-your-gemini-api-key
# Optional generic override when using another OpenAI-compatible provider.
LLM_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hanoi-food-agentic-rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.6-flash
LLM_REASONING_EFFORT=minimal
LLM_MAX_OUTPUT_TOKENS=800
LLM_TIMEOUT_SECONDS=30
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Compose preloads this model into a persistent cache before backend startup.
EMBEDDING_LOCAL_FILES_ONLY=true

# FastAPI on host:
QDRANT_URL=http://127.0.0.1:6333
# FastAPI in Docker Compose:
# QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=
# Legacy fallback when QDRANT_URL is omitted:
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=hanoi_food_current
QDRANT_VOLUME_NAME=qdrant_storage
QDRANT_TIMEOUT_SECONDS=1
RAG_MIN_SCORE=0.5
# Local exact/BM25 catalog.
FOOD_CATALOG_PATH=data/processed/food_chunks.json
QUERY_ROUTER_CONFIDENCE=0.35

EXTERNAL_RETRY_ATTEMPTS=3
EXTERNAL_RETRY_BASE_SECONDS=0.25
EXTERNAL_RETRY_MAX_SECONDS=2
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_RESET_SECONDS=30
HEALTHCHECK_TIMEOUT_SECONDS=3
LOG_LEVEL=INFO

# Local monitoring. Production must use a strong Grafana password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_RETENTION_TIME=7d
PROMETHEUS_RETENTION_SIZE=1GB

# Development cookie settings. Use secure=true behind HTTPS in production.
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_MAX_AGE_SECONDS=3600
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/
# AUTH_COOKIE_DOMAIN=

CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
# Conservative AI request guard; this is not exact provider token accounting.
LLM_DAILY_USER_REQUESTS=100
LLM_DAILY_GLOBAL_REQUESTS=1000
LLM_BUDGET_WINDOW_SECONDS=86400
LOGIN_RATE_LIMIT_REQUESTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
REGISTER_RATE_LIMIT_REQUESTS=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
DB_SCHEMA_CHECK=true

# compose.prod.yml only:
# PUBLIC_DOMAIN=food.example.com
# ACME_EMAIL=admin@example.com
# BACKEND_IMAGE=ghcr.io/example/hanoi-food-backend:commit-sha
# FRONTEND_IMAGE=ghcr.io/example/hanoi-food-frontend:commit-sha
# POSTGRES_PASSWORD=replace-with-a-strong-password
# GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
