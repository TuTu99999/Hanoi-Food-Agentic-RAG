APP_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_travel_food
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

GITHUB_TOKEN=replace-with-your-github-models-token
LLM_BASE_URL=https://models.inference.ai.azure.com
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Production/runtime should use a model already cached or baked into the image.
EMBEDDING_LOCAL_FILES_ONLY=true

# FastAPI on host:
QDRANT_URL=http://localhost:6333
# FastAPI in Docker Compose:
# QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=
# Legacy fallback when QDRANT_URL is omitted:
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=hanoi_knowledge_current
QDRANT_TIMEOUT_SECONDS=5
RAG_MIN_SCORE=0.5

EXTERNAL_RETRY_ATTEMPTS=3
EXTERNAL_RETRY_BASE_SECONDS=0.25
EXTERNAL_RETRY_MAX_SECONDS=2
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_RESET_SECONDS=30
HEALTHCHECK_TIMEOUT_SECONDS=3
LOG_LEVEL=INFO

# Development cookie settings. Use secure=true behind HTTPS in production.
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_MAX_AGE_SECONDS=3600
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/
# AUTH_COOKIE_DOMAIN=

CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
DB_SCHEMA_CHECK=true
